<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>@ViewData["Title"] · VALEM Yönetim</title>
    <link rel="stylesheet" href="~/platform-admin/admin.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-area="PlatformAdmin" asp-controller="Dashboard" asp-action="Index">
            <span class="brand-mark">V</span>
            <span><strong>VALEM</strong><small>Geliştirici yönetimi</small></span>
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav aria-label="Ana menü">
                <a asp-area="PlatformAdmin" asp-controller="Dashboard" asp-action="Index">Özet</a>
                <a asp-area="PlatformAdmin" asp-controller="Companies" asp-action="Index">Firmalar</a>
                <a asp-area="PlatformAdmin" asp-controller="Users" asp-action="Index">Kullanıcılar</a>
                <a asp-area="PlatformAdmin" asp-controller="Registrations" asp-action="Index">Başvurular</a>
                <a asp-area="PlatformAdmin" asp-controller="Branches" asp-action="Index">Şubeler</a>
                <a asp-area="PlatformAdmin" asp-controller="Tickets" asp-action="Index">Vale kayıtları</a>
                <a asp-area="PlatformAdmin" asp-controller="Audit" asp-action="Index">Denetim</a>
                <a asp-area="PlatformAdmin" asp-controller="Diagnostics" asp-action="Index">Hatalar</a>
                <a asp-area="PlatformAdmin" asp-controller="Database" asp-action="Index">Veritabanı</a>
                <a asp-area="PlatformAdmin" asp-controller="System" asp-action="Index">Sistem</a>
            </nav>
            <form class="logout" asp-area="PlatformAdmin" asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button class="button ghost" type="submit">Çıkış</button>
            </form>
        }
    </header>
    <main class="page-shell">
        @if (TempData["Success"] is string success)
        {
            <div class="alert success" role="status">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert error" role="alert">@error</div>
        }
        @RenderBody()
    </main>
</body>
</html>
