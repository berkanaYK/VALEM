@model IReadOnlyList<PlatformUserRow>
@{
    ViewData["Title"] = "Kullanıcılar";
}
<div class="page-heading"><div><div class="eyebrow">Hesap ve destek yönetimi</div><h1>Kullanıcılar</h1><p>Rolleri, erişimi, e-posta doğrulamasını ve kilit durumunu yönetin.</p></div></div>
<form method="get" class="searchbar"><input name="search" value="@ViewBag.Search" placeholder="Ad, e-posta veya firma" aria-label="Kullanıcı ara" /><button class="button secondary">Ara</button><a class="button ghost" asp-action="Index">Temizle</a></form>
<section class="panel table-wrap"><table><thead><tr><th>Kullanıcı</th><th>Firma / Şube</th><th>Sürüm</th><th>Roller</th><th>Durum</th><th>Son giriş</th><th></th></tr></thead><tbody>
@foreach (var row in Model)
{
    <tr><td><strong>@row.FullName</strong><small class="cell-subtitle">@row.Email</small></td><td>@row.CompanyName<small class="cell-subtitle">@(row.BranchName ?? "Şube yok")</small></td><td><span class="status-pill @(row.IsPremium ? "good" : "muted")">@(row.IsPremium ? "Ömür Boyu" : "Deneme")</span></td><td>@string.Join(", ", row.Roles)</td><td><span class="status-pill @(row.IsActive ? "good" : "muted")">@(row.IsActive ? "Aktif" : "Pasif")</span>@if (row.IsLocked) { <span class="status-pill warn">Kilitli</span> } @if (!row.EmailConfirmed) { <span class="status-pill warn">E-posta bekliyor</span> }</td><td>@(row.LastLoginAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")</td><td><a asp-action="Edit" asp-route-id="@row.Id">Yönet</a></td></tr>
}
</tbody></table>@if (Model.Count == 0) { <div class="empty-inline">Arama ölçütüne uyan kullanıcı yok.</div> }</section>
