@model PlatformUserEditModel
@{
    ViewData["Title"] = "Kullanıcı düzenle";
}
<div class="page-heading"><div><a class="back-link" asp-action="Index">← Kullanıcılar</a><h1>@Model.FullName</h1><p>@Model.CompanyName · Son giriş: @(Model.LastLoginAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "henüz yok") · @Model.ActiveDeviceSessions hatırlanan oturum · @Model.ActivePushRegistrations bildirim cihazı</p></div></div>
<section class="panel form-panel"><form asp-action="Edit" method="post" class="form-stack">
    @Html.AntiForgeryToken()<input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <div class="field-grid"><div><label asp-for="FullName"></label><input asp-for="FullName" /><span asp-validation-for="FullName" class="validation"></span></div><div><label asp-for="Email"></label><input asp-for="Email" inputmode="email" /><span asp-validation-for="Email" class="validation"></span></div><div><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" inputmode="tel" /></div><div><label asp-for="JobTitle"></label><input asp-for="JobTitle" /></div></div>
    <div class="field-grid"><div><label asp-for="BirthDate"></label><input asp-for="BirthDate" type="date" /><span asp-validation-for="BirthDate" class="validation"></span></div><div><label asp-for="City"></label><input asp-for="City" maxlength="80" /></div></div>
    <label asp-for="About"></label><textarea asp-for="About" rows="3" maxlength="300"></textarea>
    <label asp-for="BranchId"></label><select asp-for="BranchId">@for (var i = 0; i < Model.BranchIds.Count; i++) { <option value="@Model.BranchIds[i]">@Model.BranchNames[i]</option> }</select><span asp-validation-for="BranchId" class="validation"></span>
    <fieldset><legend>Firma rolleri</legend><div class="choice-grid">@foreach (var role in Model.AvailableRoles) { var selected = Model.SelectedRoles.Contains(role, StringComparer.OrdinalIgnoreCase); <label class="check-chip"><input type="checkbox" name="SelectedRoles" value="@role" checked="@selected" /><span>@role</span></label> }</div><span asp-validation-for="SelectedRoles" class="validation"></span></fieldset>
    <div class="choice-grid"><label class="check-row"><input asp-for="IsActive" /><span><strong>Hesap aktif</strong><small>Kapandığında uygulama erişimi kesilir.</small></span></label><label class="check-row"><input asp-for="EmailConfirmed" /><span><strong>E-posta doğrulandı</strong><small>Destek sonrası doğrulamayı elle düzeltebilirsiniz.</small></span></label></div>
    @if (Model.IsLocked) { <div class="alert warn">Bu hesap kilitli. Kaydettiğinizde başarısız giriş sayacı ve kilit kaldırılır.</div> }
    <p class="fine-print">Her kayıtta güvenlik damgası yenilenir ve hatırlanan cihaz oturumları kapatılır; kullanıcı yeniden kimlik doğrular.</p>
    <div class="form-actions"><button class="button primary" type="submit">Kaydet ve oturumları yenile</button><a class="button ghost" asp-action="Index">Vazgeç</a></div>
</form></section>
<section class="panel form-panel"><div class="panel-heading flush"><div><h2>Kullanıcıya destek bildirimi</h2><p>Mesaj uygulama içi bildirimlere kaydedilir; etkin cihaz varsa Firebase ile de gönderilir.</p></div></div><form asp-action="SendNotification" method="post" class="form-stack support-form">@Html.AntiForgeryToken()<input name="id" value="@Model.Id" type="hidden" /><label for="support-title">Başlık</label><input id="support-title" name="title" minlength="3" maxlength="140" required placeholder="Örn. Hesabınız güncellendi" /><label for="support-message">Mesaj</label><textarea id="support-message" name="message" minlength="3" maxlength="600" rows="3" required placeholder="Kullanıcıya iletilecek açıklama"></textarea><div class="form-actions"><button class="button secondary" type="submit">Bildirimi gönder</button></div></form></section>
<section class="panel danger-zone"><div><h2>Tüm oturumları kapat</h2><p>JWT güvenlik damgasını yeniler; hatırlanan oturumları ve bildirim cihazlarını iptal eder.</p></div><form asp-action="RevokeSessions" method="post">@Html.AntiForgeryToken()<input name="id" value="@Model.Id" type="hidden" /><button class="button danger" type="submit">Oturumları kapat</button></form></section>
<section class="panel danger-zone"><div><h2>Authenticator güvenliğini sıfırla</h2><p>Kullanıcı telefonunu kaybettiyse 2FA anahtarını kaldırır ve tüm oturumları kapatır. Sonraki girişte yeniden kurulum gerekir.</p></div><form asp-action="ResetTwoFactor" method="post">@Html.AntiForgeryToken()<input name="id" value="@Model.Id" type="hidden" /><button class="button danger" type="submit">2FA’yı sıfırla</button></form></section>
