<Page
    x:Class="VALE.Client.Pages.AdministrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="AdministrationPage_Loaded">

    <Grid Padding="24,8,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Yönetim" />

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasSuccess, Mode=OneWay}"
                Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
                Severity="Success" />
        </StackPanel>

        <TabView Grid.Row="2" IsAddTabButtonVisible="False">
            <TabViewItem Header="Şubeler" IsClosable="False">
                <Grid Padding="0,12,0,0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Header="Kod"
                                MaxLength="20"
                                Text="{x:Bind ViewModel.BranchCode, Mode=TwoWay}" />
                            <TextBox
                                Grid.Column="1"
                                Header="Şube adı"
                                Text="{x:Bind ViewModel.BranchName, Mode=TwoWay}" />
                            <TextBox
                                Grid.Column="2"
                                Header="Şehir"
                                Text="{x:Bind ViewModel.BranchCity, Mode=TwoWay}" />
                            <Button
                                Grid.Column="3"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.CreateBranchCommand}"
                                Content="Şube oluştur"
                                Style="{StaticResource AccentButtonStyle}" />
                            <TextBox
                                Grid.Row="1"
                                Grid.ColumnSpan="4"
                                Header="Adres"
                                Text="{x:Bind ViewModel.BranchAddress, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Branches}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="56" Padding="8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Code}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding City}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Kullanıcılar" IsClosable="False">
                <Grid Padding="0,12,0,0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Header="Ad soyad"
                                Text="{x:Bind ViewModel.UserFullName, Mode=TwoWay}" />
                            <TextBox
                                Grid.Column="1"
                                Header="E-posta"
                                InputScope="EmailSmtpAddress"
                                Text="{x:Bind ViewModel.UserEmail, Mode=TwoWay}" />
                            <PasswordBox
                                x:Name="NewUserPassword"
                                Grid.Column="2"
                                Header="Geçici parola"
                                PasswordChanged="NewUserPassword_PasswordChanged" />
                            <ComboBox
                                Grid.Row="1"
                                Header="Şube"
                                DisplayMemberPath="Name"
                                ItemsSource="{x:Bind ViewModel.Branches}"
                                SelectedItem="{x:Bind ViewModel.SelectedBranch, Mode=TwoWay}" />
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Header="Rol"
                                ItemsSource="{x:Bind ViewModel.AvailableRoles}"
                                SelectedItem="{x:Bind ViewModel.SelectedRole, Mode=TwoWay}" />
                            <Button
                                Grid.Row="1"
                                Grid.Column="2"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.CreateUserCommand}"
                                Content="Kullanıcı oluştur"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Users}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="58" Padding="8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding FullName}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Email}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding BranchName}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding RolesText}" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding StatusText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
