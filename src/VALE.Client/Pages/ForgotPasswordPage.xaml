<Page
    x:Class="VALE.Client.Pages.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel
            Width="520"
            MaxWidth="520"
            Padding="24,24,24,36"
            HorizontalAlignment="Center"
            Spacing="16">

            <Button
                Content="← Giriş ekranına dön"
                Click="Back_Click"
                Style="{StaticResource TextActionButtonStyle}" />

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Şifrenizi sıfırlayın" />
                <TextBlock
                    Style="{StaticResource PageSubtitleStyle}"
                    Text="Kayıtlı e-posta adresinize 6 haneli doğrulama kodu gönderilir." />
            </StackPanel>

            <InfoBar
                x:Name="StatusBar"
                IsClosable="True"
                IsOpen="False" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBox
                        x:Name="EmailInput"
                        Header="E-posta"
                        InputScope="EmailSmtpAddress"
                        PlaceholderText="ornek@firma.com" />
                    <Button
                        x:Name="SendCodeButton"
                        Content="Sıfırlama kodunu gönder"
                        Click="SendCode_Click"
                        Style="{StaticResource PrimaryActionButtonStyle}" />

                    <StackPanel x:Name="ResetPanel" Spacing="12" Visibility="Collapsed">
                        <TextBox
                            x:Name="CodeInput"
                            Header="6 haneli kod"
                            MaxLength="6"
                            PlaceholderText="000000" />
                        <PasswordBox
                            x:Name="NewPasswordInput"
                            Header="Yeni parola"
                            PlaceholderText="En az 10 karakter" />
                        <Button
                            x:Name="ResetButton"
                            Content="Yeni parolayı kaydet"
                            Click="Reset_Click"
                            Style="{StaticResource PrimaryActionButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
