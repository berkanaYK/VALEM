<Page
    x:Class="VALE.Client.Pages.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <NavigationView
        x:Name="ShellNavigation"
        AlwaysShowHeader="True"
        CompactModeThresholdWidth="720"
        ExpandedModeThresholdWidth="1080"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        ItemInvoked="ShellNavigation_ItemInvoked"
        Loaded="ShellNavigation_Loaded"
        PaneDisplayMode="Auto"
        PaneTitle="VALE">

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Genel Bakış" Tag="dashboard">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Aktif Araçlar" Tag="tickets">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="List" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Araç Kabul" Tag="checkin">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Add" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Raporlar" Tag="reports">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Calendar" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="İşlem Geçmişi" Tag="history">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Clock" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AdministrationNavItem" Content="Yönetim" Tag="administration" Visibility="Collapsed">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Admin" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.PaneHeader>
            <StackPanel x:Name="BranchSelectorPanel" Margin="0,6,0,10" Spacing="5" Visibility="Collapsed">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Aktif şube" />
                <ComboBox
                    x:Name="BranchSelector"
                    AutomationProperties.Name="Aktif şubeyi seç"
                    DisplayMemberPath="Name"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="BranchSelector_SelectionChanged" />
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Ayarlar" Tag="settings">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Oturumu kapat" Tag="logout">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="LeaveChat" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <NavigationView.PaneFooter>
            <StackPanel Margin="12,10" Spacing="3">
                <TextBlock x:Name="UserNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="BranchNameText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </NavigationView.PaneFooter>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
