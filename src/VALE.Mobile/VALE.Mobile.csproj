<Project Sdk="Microsoft.NET.Sdk">
  <!-- VALEM v3.5.4 build 23: password registration and username login. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>VALE.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
    <ApplicationTitle>VALE</ApplicationTitle>
    <ApplicationId>com.berkanayk.vale</ApplicationId>
    <ApplicationDisplayVersion>3.5.4</ApplicationDisplayVersion>
    <ApplicationVersion>23</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.100" />
    <PackageReference Include="Plugin.InAppBilling" Version="10.0.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Xamarin.Firebase.Messaging" Version="125.1.1" />
    <!-- Keep the AndroidX KTX graph on the same line as MAUI 10.0.100. Firebase's
         broad transitive minimums otherwise let NuGet mix 1.10/2.9 KTX packages
         with MAUI's 1.13/2.11 core packages (NU1608). -->
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.9.4" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
    <ProjectReference Include="..\VALE.Contracts\VALE.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" MonochromeFile="Resources\AppIcon\appiconmono.svg" ForegroundScale="0.72" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F4F6FB" BaseSize="256,256" />
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\tab_*.svg" BaseSize="32,32" />
    <GoogleServicesJson Include="Platforms\Android\google-services.json" Condition="Exists('Platforms\Android\google-services.json')" />
  </ItemGroup>
</Project>
