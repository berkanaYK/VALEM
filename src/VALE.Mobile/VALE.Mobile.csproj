<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>VALE.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
    <ApplicationTitle>VALE</ApplicationTitle>
    <ApplicationId>com.berkanayk.vale</ApplicationId>
    <ApplicationDisplayVersion>2.0.2</ApplicationDisplayVersion>
    <ApplicationVersion>5</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <ProjectReference Include="..\VALE.Contracts\VALE.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F2F76" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F4F6FB" BaseSize="256,256" />
    <MauiImage Include="Resources\Images\*" />
  </ItemGroup>
</Project>
