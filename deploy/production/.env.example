# Bu dosyayı .env olarak kopyalamayın; init-env.sh güvenli değerleri üretir.
VALEM_DOMAIN=api.valemyonetim.com
VALEM_PANEL_DOMAIN=panel.valemyonetim.com
VALEM_IMAGE_TAG=3.6.0
HTTP_PORT=80
HTTPS_PORT=443
API_BIND_ADDRESS=CHANGE_TO_VALEM_VM_PRIVATE_IP
API_HOST_PORT=50180

POSTGRES_DB=valem
POSTGRES_USER=valem
POSTGRES_PASSWORD=GENERATE_WITH_INIT_SCRIPT
DB_MAX_POOL_SIZE=40
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_WORK_MEM=8MB
POSTGRES_SLOW_QUERY_MS=1000
POSTGRES_CPU_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=4g
POSTGRES_MEMORY_RESERVATION=2g
POSTGRES_SHM_SIZE=512m

API_CPU_LIMIT=1.5
API_MEMORY_LIMIT=2g
API_MEMORY_RESERVATION=512m
CADDY_CPU_LIMIT=0.5
CADDY_MEMORY_LIMIT=512m
CADDY_MEMORY_RESERVATION=128m

JWT_KEY=GENERATE_WITH_INIT_SCRIPT
DATA_PROTECTION_CERTIFICATE_PASSWORD=GENERATE_WITH_INIT_SCRIPT
JWT_ISSUER=VALE.Api
JWT_AUDIENCE=VALE.Client
JWT_EXPIRY_MINUTES=480
DEVICE_SESSION_LIFETIME_DAYS=30

PLATFORM_ADMIN_EMAIL=developer@example.com
PLATFORM_ADMIN_PASSWORD=GENERATE_WITH_INIT_SCRIPT
PLATFORM_ADMIN_FULL_NAME=VALEM Platform Yöneticisi

EMAIL_ENABLED=false
EMAIL_TRANSPORT=Brevo
EMAIL_BREVO_API_KEY=
EMAIL_BREVO_BASE_URL=https://api.brevo.com/v3
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=VALEM

FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloudflare Tunnel kimlik JSON'u .env yerine
# secrets/cloudflare-tunnel-credentials.json dosyasında tutulur.

# Google Play Console'da aynı ürün kimliğiyle tek seferlik ürün oluşturulur.
BILLING_GOOGLE_PLAY_ENABLED=false
BILLING_PACKAGE_NAME=com.berkanayk.vale
BILLING_PRODUCT_ID=valem_premium_lifetime
BILLING_FALLBACK_PRICE=USD 5.99
BILLING_DEMO_VEHICLE_LIMIT=50
BILLING_SERVICE_ACCOUNT_JSON=
BILLING_TEST_PREMIUM_EMAIL_0=
DEVELOPER_DB_PASSWORD=GENERATE_WITH_INIT_SCRIPT

BACKUP_DIR=/var/backups/valem
BACKUP_RETENTION_DAYS=7
