# Arkadaşınızın sunucudaki merkezi Caddyfile dosyasına ekleyeceği örnek blok.
# Upstream IP'yi VALEM VM'nin özel IP'siyle değiştirin. API ve web paneli
# aynı ASP.NET Core uygulamasında çalıştığı için iki alan adı aynı porta gider.
api.valemyonetim.com {
    encode zstd gzip
    reverse_proxy VALEM_VM_PRIVATE_IP:50180
}

panel.valemyonetim.com {
    encode zstd gzip
    redir / /platform-admin 302
    reverse_proxy VALEM_VM_PRIVATE_IP:50180
}
